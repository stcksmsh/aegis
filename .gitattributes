# Restore kit files are embedded byte-for-byte; kit.rs adds CRLF where Windows needs it.
apps/agent/kit/* text eol=lf
apps/agent/kit/*.bat text eol=crlf
tests/fixtures/** -text
# Read by bash on every OS (fetch-restore-kit.sh) and copied to drives as SHA256SUMS.
scripts/*.sha256 text eol=lf
scripts/*.sh text eol=lf
